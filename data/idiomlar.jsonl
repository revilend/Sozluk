{"tr":"gözden düşmek","uz":"e'tibordan qolmoq","exTr":"Adamların gözünden düştü.","exUz":"O odamlarning e'tibordan qoldi."}
{"tr":"etekleri zil çalmak","uz":"og'zi quloqig'a yetmoq","exTr":"Söylenti etekleri zil çaldı.","exUz":"Xabar og'zi qulog'iga yetib qoldi."}
{"tr":"can kulağıyla dinlemek","uz":"jon qulog'i bilan tinglamoq","exTr":"Onu can kulağıyla dinledim.","exUz":"Men uni jon qulog'i bilan tingladim."}
{"tr":"ateş püskürmek","uz":"olov purkamoq","exTr":"O adama ateş püskürdü.","exUz":"U odamga olov purkadi."}
{"tr":"yolunu kaybetmek","uz":"yo'lini yo'qatmoq","exTr":"Şehirde yolunu kaybetti.","exUz":"Qishloqda yo'lini yo'qotdi."}
{"tr":"kalbini kırmak","uz":"yuragini buzmoq","exTr":"Onun kalbini kırdılar.","exUz":"U odamlar yuragini buzdi."}
{"tr":"dilini yutmak","uz":"jim bo'lmoq","exTr":"Dilini yutup dedi.","exUz":"Jim bo'lib qoldi."}
